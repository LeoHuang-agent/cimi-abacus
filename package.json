{
  "name": "cimi-abacus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "VITE_BASE=/cimi-abacus/ tsc -b && VITE_BASE=/cimi-abacus/ vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app:sync": "npm run build && npx cap sync",
